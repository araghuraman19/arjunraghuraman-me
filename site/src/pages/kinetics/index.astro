---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const articles = (await getCollection("kinetics")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="Kinetics & PK">
  <article class="prose">
    <h1>Kinetics &amp; PK</h1>
    <p>
      Rate laws fitted to reactor data and a compartment model fitted to
      plasma and metabolite concentrations share the same core structure: a
      nonlinear model with several parameters, multiple responses that may be
      correlated, and data that may or may not identify every parameter
      individually. Pharmacokinetics adds a population layer, because
      parameters vary from subject to subject, but the toolkit underneath is
      common to both: maximum-likelihood estimation across responses, the
      parameter Jacobian and the information matrix built from it,
      identifiability analysis, and experimental design that chooses runs to
      maximize information about the parameters. The worked examples use
      Wolfram Language throughout.
    </p>
    <ul class="article-list">
      {
        articles.map((entry) => (
          <li>
            <a href={`/kinetics/${entry.id}`}>{entry.data.title}</a>
            {entry.data.tagline && <p>{entry.data.tagline}</p>}
          </li>
        ))
      }
    </ul>
  </article>
</BaseLayout>

<style>
  .article-list {
    list-style: none;
    padding: 0;
  }

  .article-list li {
    border-top: 1px solid var(--color-border);
    padding: var(--space-2) 0;
  }

  .article-list a {
    font-weight: 600;
    font-size: 1.2rem;
    text-decoration: none;
  }

  .article-list p {
    margin-top: 0.25rem;
    color: var(--color-text-muted);
  }
</style>
