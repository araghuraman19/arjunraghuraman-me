---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  /** Optional stacked/narrow export (with its own `-dark` sibling), swapped in
      below 640px so multi-panel figures stay legible on phones. */
  narrowSrc?: string;
}

const { src, alt, caption, narrowSrc } = Astro.props;
// Convention: chart exports (e.g. Wolfram plots) ship as a light-mode PNG at
// `src` plus a dark-mode sibling with a `-dark` suffix before the extension.
const toDark = (path: string) => path.replace(/(\.[^./]+)$/, "-dark$1");
const darkSrc = toDark(src);
const narrowMedia = "(max-width: 640px)";
---

<figure class="figure">
  <picture class="figure__img figure__img--light">
    {narrowSrc && <source media={narrowMedia} srcset={narrowSrc} />}
    <img src={src} alt={alt} loading="lazy" />
  </picture>
  <picture class="figure__img figure__img--dark">
    {narrowSrc && <source media={narrowMedia} srcset={toDark(narrowSrc)} />}
    <img src={darkSrc} alt={alt} loading="lazy" />
  </picture>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: var(--space-3) 0;
  }

  .figure__img {
    display: block;
  }

  .figure__img img {
    display: block;
    border: 1px solid var(--color-border);
    width: 100%;
  }

  /* Chart PNGs are styled per theme at export time (can't be re-themed via
     CSS like the site's own SVG), so ship both and toggle with the same
     data-theme mechanism used for the nav's sun/moon icons. Dark is the
     default theme, so the dark variant shows unless data-theme="light".
     display:none keeps native lazy-loading from fetching the hidden variant. */
  .figure__img--light {
    display: none;
  }

  :root[data-theme="light"] .figure__img--light {
    display: block;
  }

  :root[data-theme="light"] .figure__img--dark {
    display: none;
  }

  .figure figcaption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
</style>
