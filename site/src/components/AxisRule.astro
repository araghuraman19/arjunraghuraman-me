---
interface Props {
  /** Tick values shown along the rule, left to right. */
  ticks?: number[];
}

const { ticks = [0, 25, 50, 75, 100] } = Astro.props;
---

<div class="axis-rule">
  {
    ticks.map((tick, i) => (
      <span class="axis-tick" style={`left: ${(i / (ticks.length - 1)) * 100}%`}>
        {tick}
      </span>
    ))
  }
</div>

<style>
  .axis-rule {
    position: relative;
    height: 28px;
    border-top: 1px solid var(--color-axis-border);
  }

  .axis-tick {
    position: absolute;
    top: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-axis-tick);
    transform: translateX(-50%);
  }
</style>
